# macOS: avoid 5000 (AirPlay Receiver uses it and replies 403)
PORT=5001
CLIENT_URL=http://localhost:5173

# MongoDB — MUST be a replica set (Atlas works out of the box) because /confirm uses transactions
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/seat-booking

# Upstash Redis (console.upstash.com -> your DB -> REST API)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# Auth — use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Only used by `npm run create-admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
